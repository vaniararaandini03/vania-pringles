<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_bg"
    android:padding="28dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardIcon2"
        android:layout_width="170dp"
        android:layout_height="170dp"
        app:cardBackgroundColor="@color/choco_primary"
        app:cardCornerRadius="85dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toTopOf="@+id/tvBadge2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed">

        <ImageView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_gravity="center"
            android:contentDescription="Ikon Katalog Menu"
            android:src="@android:drawable/ic_menu_agenda"
            app:tint="@color/cream_card" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tvBadge2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_card_choco"
        android:paddingHorizontal="14dp"
        android:paddingVertical="4dp"
        android:text="CUSTOMIZE YOUR DRINK"
        android:textColor="@color/cream_bg"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/tvTitle2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardIcon2" />

    <TextView
        android:id="@+id/tvTitle2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="Pilih Menu Sesuai Seleramu"
        android:textColor="@color/choco_dark"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/tvDesc2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvBadge2" />

    <TextView
        android:id="@+id/tvDesc2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="90dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="Jelajahi puluhan varian Iced Coffee, Dark Chocolate, hingga Signature Series dengan rekomendasi terbaik setiap minggunya."
        android:textColor="@color/choco_primary"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle2" />

</androidx.constraintlayout.widget.ConstraintLayout>